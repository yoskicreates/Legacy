{
  "name": "legacy3-mma-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LEGACY 3.0 L3-020 web foundation with genuine Vite 6.3.6 and TypeScript 5.8.3; gameplay not yet implemented",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:clean": "npm ci --ignore-scripts",
    "build": "vite build",
    "lint": "node scripts/phase-tools.mjs lint",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:types:negative && npm test && npm run build",
    "test:types:negative": "node scripts/strict-negative-test.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build:vite": "vite build",
    "dev:vite": "vite --host 127.0.0.1",
    "preview:vite": "vite preview",
    "check:vite": "node scripts/vite-readiness.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.6"
  }
}
