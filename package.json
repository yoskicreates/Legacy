{
  "name": "legacy3-mma-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LEGACY 3.0 L3-034: reproducible, verifiable source/build manifest (non-playable foundation)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:clean": "npm ci --ignore-scripts",
    "build": "vite build",
    "lint": "node scripts/phase-tools.mjs lint",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run lint:domains && npm run typecheck && npm run test:types:negative && npm test && npm run build",
    "test:types:negative": "node scripts/strict-negative-test.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build:vite": "vite build",
    "dev:vite": "vite --host 127.0.0.1",
    "preview:vite": "vite preview",
    "check:vite": "node scripts/vite-readiness.mjs",
    "lint:domains": "node scripts/check-domain-boundaries.mjs",
    "test:routes": "node --test tests/route-state.test.mjs",
    "test:clock": "node --test tests/game-clock.test.mjs",
    "typecheck:clock": "tsc --project tsconfig.clock.json --noEmit",
    "test:random": "node --test tests/random-source.test.mjs",
    "typecheck:random": "tsc --project tsconfig.random.json --noEmit",
    "test:events": "node --test tests/domain-events.test.mjs",
    "typecheck:events": "tsc --project tsconfig.events.json --noEmit",
    "typecheck:state": "tsc --project tsconfig.state.json --noEmit",
    "test:state": "node --test tests/game-state-schema.test.mjs",
    "test:indexeddb": "node --test tests/indexeddb.test.mjs",
    "typecheck:indexeddb": "tsc --project tsconfig.indexeddb.json --noEmit",
    "test:indexeddb:negative": "node scripts/indexeddb-negative-test.mjs",
    "test:autosave": "node --test tests/autosave.test.mjs",
    "typecheck:autosave": "tsc --project tsconfig.autosave.json --noEmit",
    "test:autosave:negative": "node scripts/autosave-negative-test.mjs",
    "test:manual-slots": "node --test tests/manual-slots.test.mjs",
    "typecheck:manual-slots": "tsc --project tsconfig.manual-slots.json --noEmit",
    "test:manual-slots:negative": "node scripts/manual-slots-negative-test.mjs",
    "typecheck:export-import": "tsc --project tsconfig.export-import.json --noEmit",
    "test:export-import": "node --test tests/export-import.test.mjs",
    "test:export-import:negative": "node scripts/export-import-negative-test.mjs",
    "typecheck:migrations": "tsc --project tsconfig.migrations.json --noEmit",
    "test:migrations": "node --test tests/migrations.test.mjs",
    "test:migrations:negative": "node scripts/migrations-negative-test.mjs",
    "typecheck:fixtures": "tsc --project tsconfig.fixtures.json --noEmit",
    "test:fixtures": "node --test tests/fixture-system.test.mjs",
    "test:fixtures:negative": "node scripts/fixtures-negative-test.mjs",
    "typecheck:build-manifest": "tsc --project tsconfig.build-manifest.json --noEmit",
    "test:build-manifest": "node --test tests/build-manifest.test.mjs",
    "test:build-manifest:negative": "node scripts/build-manifest-negative-test.mjs",
    "manifest:generate": "node scripts/build-manifest.mjs generate",
    "manifest:verify": "node scripts/build-manifest.mjs verify"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.6"
  },
  "dependencies": {
    "preact": "10.29.8",
    "pixi.js": "8.20.1"
  }
}
